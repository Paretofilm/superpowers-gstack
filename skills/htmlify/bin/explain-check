#!/usr/bin/env python3
"""Check an explainer page before it is opened or published.

    explain-check <page.html> [--out DIR]

Two passes:
  rules   read the file: the first <style> is styles/explainer.css verbatim, every card
          (<section>) starts with a .tag badge and has at most one .key insight, every
          <svg> has role="img" and an aria-label, no companion.css and no linked
          stylesheet. Identifier-like words outside <code> are warnings.
  layout  load the page in gstack's headless browser at desktop (1100 px) and phone
          (390 px) width and run explain/check.js: text that is clipped, runs out of its
          box, is cut by a drawing's edge, overlaps other text, or has a line drawn
          through it. Then screenshot the
          whole page (light, dark, phone) and every card (light), for the visual check.

Prints each finding, then the screenshot paths, then a JSON verdict as the last line.
Exit 0 clean (warnings allowed) · 1 findings · 4 page unreadable · 5 no browser (set
GSTACK_BROWSE, or install gstack) · 64 usage.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from html.parser import HTMLParser
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
CSS = SKILL_DIR / "styles" / "explainer.css"
CHECK_JS = SKILL_DIR / "explain" / "check.js"
WIDTHS = (("desktop", "1100x900"), ("phone", "390x844"))
# Words a reader never sees outside the code: commit shas, requirement and task ids,
# snake_case and camelCase names. Text inside <code> or .mono is exempt: a command the
# reader types is not internal. Apple's own camelCase names are not identifiers.
IDENT_RES = (
    (re.compile(r"\b(?=[0-9a-f]*\d)(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\b"), "looks like a commit sha"),
    (re.compile(r"\b(?:[A-Z]{1,3}\d+(?:\.\d+)+|[A-Z]{2,5}-\d+|[A-Z][a-z]?\d+(?:\.\d+)*)\b"),
     "looks like a requirement or task id"),
    (re.compile(r"\b[a-z][a-z0-9]*_[a-z0-9_]+\b"), "snake_case name"),
    (re.compile(r"\b[a-z]+[A-Z][A-Za-z0-9]*\b"), "camelCase name"),
)
BRAND_WORDS = {"iPhone", "iPad", "iOS", "iPadOS", "macOS", "watchOS", "tvOS", "visionOS",
               "iCloud", "iMessage", "eBay", "iMac", "xOS"}


def norm(css: str) -> str:
    """Comments and whitespace do not count: the rules must be the same, not the layout."""
    return re.sub(r"\s+", " ", re.sub(r"/\*.*?\*/", "", css, flags=re.S)).strip()


class Page(HTMLParser):
    """Collects what the rules need: style blocks, cards and their first child,
    svgs, and visible text outside code."""

    VOID = {"meta", "link", "br", "img", "input", "hr", "source", "wbr", "path", "circle",
            "rect", "line", "ellipse", "polygon", "polyline", "use", "stop"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.styles, self.links, self.svgs = [], [], []
        self.sections = []          # [first-child classes or None]
        self.keys = []              # .key insight boxes per card
        self.text = []              # (text, section index)
        self.stack = []             # (tag, is_code, in_style_or_script)
        self._style_buf = None
        self._await_first_child = None

    def _code(self):
        return any(c for _, c, _ in self.stack)

    def _skip(self):
        return any(s for _, _, s in self.stack)

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        classes = (a.get("class") or "").split()
        if self._await_first_child is not None:
            self.sections[self._await_first_child] = classes
            self._await_first_child = None
        if "key" in classes and any(t == "section" for t, _, _ in self.stack):
            self.keys[-1] += 1
        if tag == "section":
            self.sections.append(None)
            self.keys.append(0)
            self._await_first_child = len(self.sections) - 1
        if tag == "svg":
            self.svgs.append(a)
        if tag == "link":
            self.links.append(a.get("href") or "")
        if tag == "style":
            self._style_buf = []
        if tag in self.VOID:
            return
        is_code = tag in ("code", "pre", "kbd") or "mono" in classes
        self.stack.append((tag, is_code, tag in ("style", "script")))

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)

    def handle_endtag(self, tag):
        if tag == "style" and self._style_buf is not None:
            self.styles.append("".join(self._style_buf))
            self._style_buf = None
        for i in range(len(self.stack) - 1, -1, -1):
            if self.stack[i][0] == tag:
                del self.stack[i:]
                break

    def handle_data(self, data):
        if self._style_buf is not None:
            self._style_buf.append(data)
            return
        if self._skip() or self._code() or not data.strip():
            return
        if self._await_first_child is not None:
            # text before any element: the card does not start with its badge
            self.sections[self._await_first_child] = []
            self._await_first_child = None
        self.text.append((data, len(self.sections)))


def rule_findings(html: str):
    """(findings, warnings), each a list of dicts. Pure: no browser, unit-tested."""
    p = Page()
    p.feed(html)
    findings, warnings = [], []
    if not p.styles:
        findings.append({"kind": "style-missing", "detail": "no <style>: inline styles/explainer.css"})
    elif norm(p.styles[0]) != norm(CSS.read_text()):
        findings.append({"kind": "style-drift", "detail": "the first <style> is not styles/explainer.css "
                         "verbatim; copy it unchanged and put page rules in a second <style>"})
    if "companion.css" in html or any("companion" in h for h in p.links):
        findings.append({"kind": "companion", "detail": "explainer pages do not use companion.css"})
    if any(h.strip() for h in p.links):
        findings.append({"kind": "external-style", "detail": "a <link> stylesheet: the page must stand alone"})
    for i, first in enumerate(p.sections, 1):
        if not first or "tag" not in first:
            findings.append({"kind": "no-badge", "detail": f"card {i} does not start with a .tag badge"})
    for i, n in enumerate(p.keys, 1):
        if n > 1:
            findings.append({"kind": "two-insights", "detail": f"card {i} has {n} .key boxes; keep the one that matters"})
    for i, a in enumerate(p.svgs, 1):
        if a.get("role") != "img" or not (a.get("aria-label") or "").strip():
            findings.append({"kind": "svg-label", "detail": f"svg {i} needs role=\"img\" and an aria-label"})
    for text, sec in p.text:
        for rx, why in IDENT_RES:
            for m in rx.finditer(text):
                if m.group(0) in BRAND_WORDS:
                    continue
                warnings.append({"kind": "identifier", "detail": f"«{m.group(0)}» ({why}) in card {sec or 'top'}"})
    return findings, warnings


def find_browse():
    for c in (os.environ.get("GSTACK_BROWSE"),
              str(Path.home() / ".claude/skills/gstack/browse/dist/browse"),
              ".claude/skills/gstack/browse/dist/browse"):
        if c and os.access(c, os.X_OK):
            return c
    return None


def run(b, *args):
    r = subprocess.run([b, *args], capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        raise RuntimeError(f"browse {' '.join(args)}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def layout(b, page: Path, out: Path):
    """Layout findings and screenshot paths. gstack's browser only opens files under
    the temp dir or its own project, so the page and the check go to a temp dir."""
    work = Path(tempfile.mkdtemp(prefix="explain-check-"))
    shutil.copy(page, work / "page.html")
    shutil.copy(CHECK_JS, work / "check.js")
    url = (work / "page.html").as_uri()
    findings, shots = [], []
    tab = None
    try:
        opened = run(b, "newtab", "about:blank")
        m = re.search(r"tab (\d+)", opened)
        tab = m.group(1) if m else None
        for name, size in WIDTHS:
            run(b, "viewport", size)
            run(b, "goto", url)
            raw = run(b, "eval", str(work / "check.js"))
            for f in json.loads(raw.splitlines()[-1]):
                f["width"] = name
                findings.append(f)
            themes = ("light", "dark") if name == "desktop" else ("light",)
            for theme in themes:
                run(b, "js", f"document.documentElement.setAttribute('data-theme','{theme}')")
                shot = out / f"full-{name}-{theme}.png"
                run(b, "screenshot", str(shot))
                shots.append(str(shot))
            if name == "desktop":
                run(b, "js", "document.documentElement.setAttribute('data-theme','light')")
                # number the cards in the page itself: nth-of-type breaks when cards are not siblings
                n = int(run(b, "js", "(()=>{const s=document.querySelectorAll('section');"
                                     "s.forEach((e,i)=>e.setAttribute('data-explain-card',i+1));"
                                     "return s.length})()").splitlines()[-1])
                for i in range(1, n + 1):
                    shot = out / f"card-{i:02d}.png"
                    run(b, "screenshot", f'[data-explain-card="{i}"]', str(shot))
                    shots.append(str(shot))
    finally:
        if tab:
            subprocess.run([b, "closetab", tab], capture_output=True, text=True)
        shutil.rmtree(work, ignore_errors=True)
    return findings, shots


def main(argv):
    args = list(argv)
    out = None
    if "--out" in args:
        i = args.index("--out")
        if i + 1 >= len(args):
            print("usage: explain-check <page.html> [--out DIR]", file=sys.stderr)
            return 64
        out = Path(args[i + 1])
        del args[i:i + 2]
    if len(args) != 1:
        print("usage: explain-check <page.html> [--out DIR]", file=sys.stderr)
        return 64
    page = Path(args[0]).resolve()
    try:
        html = page.read_text(encoding="utf-8")
    except OSError as e:
        print(f"explain-check: cannot read {page}: {e}", file=sys.stderr)
        return 4
    out = (out or Path(tempfile.gettempdir()) / f"explain-check-{page.stem}").resolve()
    out.mkdir(parents=True, exist_ok=True)

    findings, warnings = rule_findings(html)
    b = find_browse()
    if not b:
        print("explain-check: gstack's browse binary was not found (set GSTACK_BROWSE, or install "
              "gstack). The layout check and the screenshots did not run.", file=sys.stderr)
        for f in findings:
            print(f"FINDING {f['kind']}: {f['detail']}")
        print(json.dumps({"findings": len(findings), "warnings": len(warnings), "layout": "not-run",
                          "screenshots": []}))
        return 5
    try:
        lf, shots = layout(b, page, out)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as e:
        print(f"explain-check: the browser step failed: {e}", file=sys.stderr)
        return 5
    findings += lf

    for f in findings:
        where = " · ".join(x for x in (f.get("width"), f.get("section")) if x)
        text = f" «{f['text']}»" if f.get("text") else ""
        print(f"FINDING {f['kind']}{(' [' + where + ']') if where else ''}{text}: {f['detail']}")
    for w in warnings:
        print(f"WARNING {w['kind']}: {w['detail']}")
    print("Screenshots:")
    for s in shots:
        print(f"  {s}")
    print(json.dumps({"findings": len(findings), "warnings": len(warnings), "layout": "ran",
                      "screenshots": shots}))
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
